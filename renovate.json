{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "matchManagers": ["nix"],
      "matchPackageNames": ["nixpkgs"],
      "commitMessageExtra": "({{{newVersion}}})"
    },
    {
      "matchManagers": ["nix"],
      "matchPackageNames": ["microvm", "microvm-policy"]
    }
  ]
}
